{
  "name": "loredown",
  "version": "0.6.1",
  "description": "Agent-written team knowledge as markdown in your repo — reviewed in pull requests, checked for staleness. Claude Code · Cursor · Codex.",
  "keywords": [
    "knowledge-base",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "agents-md",
    "team-memory",
    "wiki",
    "markdown"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fenriuz/loredown.git"
  },
  "homepage": "https://github.com/Fenriuz/loredown#readme",
  "bugs": "https://github.com/Fenriuz/loredown/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "loredown": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
